{
  "name": "monitorerp-api",
  "version": "0.1.0",
  "description": "Hono API for the MonitorERP KB document manager",
  "main": "dist/index.js",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@hono/zod-validator": "^0.9.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "jose": "^6.2.8",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  }
}
